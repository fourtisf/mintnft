# ── required for nothing. the engine runs with all of this blank,
#    it just sees less. ────────────────────────────────────────────

# Discovery, and now also the on-chain gates. Without these you only get
# Dexscreener's profile feed, which misses most fresh pools. This is the
# single biggest lever on signal quality — worth setting before tuning any
# threshold.
#
# HELIUS_KEY doubles as the Solana RPC for the on-chain gates below. Point
# SOLANA_RPC at any other node instead if you have one; it wins over the key.
HELIUS_KEY=
SOLANA_RPC=
BASE_RPC=
BSC_RPC=
ETH_RPC=
# Robinhood Chain, where the keys live and where the desk is pointed. This one
# does two jobs: it turns on the Pons launchpad watcher, which reads every V1
# launch out of the factory's own logs rather than waiting for a team to file a
# profile, and it points the on-chain gates at the chain.
#
# Read what those gates actually establish before counting this as protection.
# The EVM path is the LP-burn field alone, and a Pons launch locks its Uniswap
# V3 position instead of burning an LP token, so the field is never set and the
# gate abstains — recorded as not checked, never as clean.
ROBINHOOD_RPC=https://rpc.mainnet.chain.robinhood.com

# Storage. Unset means the file register at data/register.json, which is
# correct and single-process. Set it and the engine runs on Postgres, where
# `calls` refuses UPDATE and DELETE at the database — append-only stops being
# a convention this process keeps and becomes something enforced against it.
#
#   createdb nekara && psql -d nekara -f ../schema.sql
#   node migrate-pg.js --from ./data/register.json --to $DATABASE_URL
#
# The migration copies the hashes rather than recomputing them, then verifies
# the chain back out of the database, and refuses outright if the source does
# not verify or the target already holds calls.
DATABASE_URL=

# Push. Create a bot with @BotFather, add it to the channel as admin,
# then read the chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TG_TOKEN=
TG_CHAT=

# API
PORT=8787
DATA_FILE=./data/register.json

# Sessions. Tier gating is resolved server-side and the tier travels in a
# signed token, so this key is what stands between a reader and Tier III.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Unset means a random key per restart, so every session dies on deploy.
SESSION_SECRET=
AUTH_DOMAIN=localhost

# Where the keys live. KEYS_CONTRACT and KEYS_RPC must both be set, or every
# visitor is public tier and the mint panel says it is not wired — the safe
# direction to fail, but key holders get nothing until it is filled in.
# BASE_RPC is still read as a fallback for KEYS_RPC.
KEYS_CONTRACT=
KEYS_RPC=https://rpc.mainnet.chain.robinhood.com

# The mint panel reads these too. KEYS_CHAIN_ID decides which network the site
# asks a wallet to switch to before it will send anything; KEYS_EXPLORER is
# only where transaction links point.
#   Robinhood Chain   4663   https://robinhoodchain.blockscout.com
#   its testnet      46630   https://explorer.testnet.chain.robinhood.com
KEYS_CHAIN_ID=4663
KEYS_EXPLORER=https://robinhoodchain.blockscout.com


# How far behind the desk a reader with no key sits, in seconds. Tier III sees
# a call as it fires, II at +5s, I at +10s, and those three are the promise —
# they are not settable. An hour of public delay with no keys minted is a wait
# nobody has paid to skip and an empty page for everyone. Lower it deliberately.
PUBLIC_DELAY_S=3600

# Which desk the screener writes as. The house desk is 1; the register is
# multi-caller from day one and the caller is inside the record hash.
CALLER_ID=1

# Anchoring. Without a publisher wired in index.js the chain is never posted
# on-chain and /api/verify reports the register as unanchored, which is true.
ANCHOR_CONTRACT=

# Which chains this desk fires on. Empty is the default and means all of them —
# whatever chain a team filed a profile for, which is most of what Dexscreener
# lists. Narrow it to a comma-separated list and the tracked_chain gate refuses
# the rest by name, first, before any threshold gets blamed for it. The startup
# log prints which of the two is in force, so it is never a guess.
CHAINS=

# Scoring. Defaults are reasoned, not measured. Do not change them on a
# hunch — run backtest.js against recorded snapshots first.
#
# 76 of a 134 maximum. Raising the ceiling without raising this would loosen
# the filter, not tighten it.
SCORE_TO_FIRE=76
MIN_LIQUIDITY_USD=15000
# Verticality over the hour, not just the last five minutes. A win is 2×, so a
# token already up this much on the hour has made the move without us.
MAX_HOUR_PUMP_PCT=100
MAX_MARKET_CAP=2000000

# Flow shape. Not smart money — Dexscreener publishes no wallet addresses — but
# the average clip size is the closest the data comes to asking whether real
# money is involved. Below the floor the flow is dust; above SIZE_FLOOR_USD it
# starts earning points.
MIN_AVG_TRADE_USD=50
SIZE_FLOOR_USD=250

# On-chain gates. These read the chain rather than the tape, and they only run
# on a candidate everything above already accepted — no RPC call is spent on a
# token that was going to be refused anyway.
#
# With no node configured for a chain they do not run at all, the engine fires
# exactly as it did before they existed, and each call records
# `chainChecks: null`. The site prints that as "not checked" and never as
# clean: a gate that could not run must not be readable as a gate that passed.
MAX_TOP_HOLDER_PCT=0.15
MAX_TOP10_PCT=0.40
# v2-style pools only — the pair address is the LP token there, so the burned
# share is two calls and no interpretation. A v3 position is an NFT, totalSupply
# reverts, and the gate abstains rather than reading every v3 pool as unburned.
MIN_LP_BURNED_PCT=0.90
