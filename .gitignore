node_modules/
.env
.env.*
!.env.example

# The deploy key. contracts/keys.js reads DEPLOY_PK from the environment and
# never from an argument, so it lands in a file — and .env.* does not match a
# name like .keys.env, which is the sort of near-miss that puts a private key
# in a public repository. Match the shape, not one filename.
*.env
*.env.*
.keys.env
keys.env
out/keys.*.json
data/
*.log
out/
# render scaffolding — screenshots taken to check the work, never deliverables
brand/node_modules/
brand/s.js
brand/shot*.js
brand/render.js
brand/c1.png
brand/v.png
brand/*-preview.png
.season-secret
